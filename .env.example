# ── Marca ─────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=FAMEFILE
NEXT_PUBLIC_BRAND_X_HANDLE=
# Endereço público do site (ex.: https://famefile.com). Usado em SEO, sitemap e Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ─────────────────
# Sem estas variáveis o site usa o conteúdo local (src/lib/data/content.ts) e o admin fica em modo leitura.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: nunca comite, nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin (/admin) ────────────────────────────────────
# Senha do painel. Em produção, sem ela o admin fica bloqueado.
ADMIN_PASSWORD=
# Texto aleatório longo (ex.: gerado com `openssl rand -hex 32`). Trocar desloga todo mundo.
ADMIN_SECRET=

# ── Robô editor (próxima etapa) ───────────────────────
# ANTHROPIC_API_KEY=
# CRON_SECRET=
